rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function myInvitedByUid() {
      return exists(myUserPath())
        ? get(myUserPath()).data.get('invitedByUid', null)
        : null;
    }

    function invitationPath(token) {
      return /databases/$(database)/documents/invitations/$(token);
    }

    function invitationExists(token) {
      return exists(invitationPath(token));
    }

    /** Inviter may listen on merge doc id (invitation token) even before merge doc exists. */
    function isInviterOfInvitation(token) {
      return invitationExists(token)
        && get(invitationPath(token)).data.inviterUid == request.auth.uid;
    }

    function isInviteeEmailOfInvitation(token) {
      return invitationExists(token)
        && get(invitationPath(token)).data.inviteeEmail != null
        && request.auth.token.email != null
        && get(invitationPath(token)).data.inviteeEmail == request.auth.token.email;
    }

    match /invitations/{token} {
      allow read: if isAuthed() && resource.data.inviterUid == request.auth.uid;
      allow read: if isAuthed() && resource.data.joinedUid == request.auth.uid;
      allow read: if isAuthed()
        && resource.data.inviteeEmail != null
        && resource.data.inviteeEmail == request.auth.token.email;
      allow read: if isAuthed()
        && myInvitedByUid() != null
        && resource.data.inviterUid == myInvitedByUid();
      allow read: if isAuthed()
        && exists(/databases/$(database)/documents/users/$(resource.data.inviterUid))
        && get(/databases/$(database)/documents/users/$(resource.data.inviterUid)).data.get('invitedByUid', null) == request.auth.uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAuthed() && (
        request.auth.uid == uid
        || resource.data.get('invitedByUid', null) == request.auth.uid
        || (myInvitedByUid() != null && myInvitedByUid() == uid)
        || (myInvitedByUid() != null && resource.data.get('invitedByUid', null) == myInvitedByUid())
      );
      allow write: if isAuthed() && request.auth.uid == uid;

      match /familyMembers/{memberId} {
        allow read: if isAuthed() && (
          request.auth.uid == uid
          || (myInvitedByUid() != null && myInvitedByUid() == uid)
        );
        allow write: if false;
      }
    }

    match /treeMergeRequests/{token} {
      // Separate allow read lines so list/get queries stay valid (OR in one rule breaks queries).
      allow read: if isAuthed() && resource != null && resource.data.inviterUid == request.auth.uid;
      allow read: if isAuthed() && resource != null && resource.data.inviteeUid == request.auth.uid;
      allow read: if isAuthed()
        && resource != null
        && resource.data.inviteeEmail != null
        && request.auth.token.email != null
        && resource.data.inviteeEmail == request.auth.token.email;
      // Doc listeners on missing merge docs (token = invitation id) — resource is null.
      allow read: if isInviterOfInvitation(token);
      allow read: if isInviteeEmailOfInvitation(token);
      allow write: if false;
    }

    match /mail/{docId} {
      allow read, write: if false;
    }

    match /premiumPayments/{reference} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /concessionRequests/{docId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.reason is string
        && request.resource.data.status == 'pending'
        && (
          !isAuthed()
          || request.resource.data.get('uid', null) == request.auth.uid
        );
      allow read, update, delete: if false;
    }

    match /treeBuildRequests/{docId} {
      allow create: if isAuthed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && request.resource.data.fileStoragePath is string
        && request.resource.data.fileDownloadUrl is string
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.status in ['awaiting_payment', 'queued'];
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /treeBuildPayments/{reference} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
